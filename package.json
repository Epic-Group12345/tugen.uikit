{
  "name": "@tugen/uikit",
  "version": "0.1.0",
  "description": "UI-kit TUGEN: токены и компоненты для лаунчера (React Native Windows), мини-приложений и веба",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "tokens",
    "css",
    "nim"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./tokens.json": "./tokens/tokens.json",
    "./css": "./css/tugen.css",
    "./css/tugen.css": "./css/tugen.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "css": "node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.src.json",
    "test": "jest"
  },
  "peerDependencies": {
    "react": ">=19.1",
    "react-native": ">=0.81"
  },
  "devDependencies": {
    "@types/jest": "^29",
    "@types/node": "^22",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.0",
    "jest": "^29.6.3",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^2",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-native": "0.81.6",
    "react-native-web": "^0.21.0",
    "ts-jest": "^29",
    "typescript": "^5.8.3"
  },
  "license": "UNLICENSED"
}
